{
  "hosting": {
    "public": "dist/news-website/browser",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/home",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/category/General",
        "destination": "/general",
        "type": 301
      },
      {
        "source": "/category/general",
        "destination": "/general",
        "type": 301
      },
      {
        "source": "/category/Political",
        "destination": "/politics",
        "type": 301
      },
      {
        "source": "/category/political",
        "destination": "/politics",
        "type": 301
      },
      {
        "source": "/category/Entertainment",
        "destination": "/entertainment",
        "type": 301
      },
      {
        "source": "/category/entertainment",
        "destination": "/entertainment",
        "type": 301
      },
      {
        "source": "/category/Sports",
        "destination": "/sports",
        "type": 301
      },
      {
        "source": "/category/sports",
        "destination": "/sports",
        "type": 301
      },
      {
        "source": "/category/Technology",
        "destination": "/technology",
        "type": 301
      },
      {
        "source": "/category/technology",
        "destination": "/technology",
        "type": 301
      },
      {
        "source": "/category/Business",
        "destination": "/business",
        "type": 301
      },
      {
        "source": "/category/business",
        "destination": "/business",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.csr.html"
      }
    ],
    "headers": [
      {
        "source": "/sitemap.xml",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/xml"
          }
        ]
      },
      {
        "source": "/robots.txt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain"
          }
        ]
      },
      {
        "source": "/favicon.png",
        "headers": [
          {
            "key": "Content-Type",
            "value": "image/png"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/manifest+json"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "/assets/images/**",
        "headers": [
          {
            "key": "Content-Type",
            "value": "image/png"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}